# ---------------------------------------------------------------------------
# Financial Habit Builder & Wealth Growth Tracker - environment variables
#
# Copy this file to `.env` in the repository root and fill in real values.
#   cp .env.example .env
# `.env` is git-ignored. NEVER commit real secrets or database credentials.
# Production values are set in the hosting dashboards (Render / Vercel).
# ---------------------------------------------------------------------------

# ---- Server (read by server/src/config/env.js) ----

NODE_ENV=development
PORT=4000

# PostgreSQL connection string (local or hosted). PostgreSQL 13+ is required.
# Example shape: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/financial_tracker

# Set to true for hosted databases that require TLS (Neon, Render external URL, ...).
DATABASE_SSL=false

# Secret used to sign JWTs. Minimum 32 characters. Generate one with:
#   npm run gen:secret
# Values containing "change-me" are rejected when NODE_ENV=production.
JWT_SECRET=change-me-run-npm-run-gen-secret-and-paste-the-output-here

# Token lifetime: a number followed by s, m, h or d (for example 8h).
JWT_EXPIRES_IN=8h

# bcrypt cost factor (4-15). 12 is a good default; use 10 if login is slow on a small host.
BCRYPT_COST=12

# Browser origin(s) allowed by CORS. Comma-separate multiple origins.
# Production example: https://your-app.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# ---- Seeding (read only by `npm run seed`) ----

SEED_ADMIN_NAME=Platform Admin
SEED_ADMIN_EMAIL=admin@example.com
# Choose your own strong password (8-72 chars, at least one letter and one number).
SEED_ADMIN_PASSWORD=

# ---- Testing (optional) ----

# Enables the real-database integration tests in server/tests/integration.
# The database name MUST contain "test" - its users table is truncated by the tests.
TEST_DATABASE_URL=
TEST_DATABASE_SSL=false

# ---- Client (Vite exposes only variables prefixed with VITE_) ----

# Leave commented in development: Vite proxies /api to http://localhost:4000.
# Production example: https://your-api.onrender.com/api
# VITE_API_URL=
